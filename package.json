{
  "name": "personal-os-quest",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "A small Habitica-style RPG for personal development. Web + Discord, one shared core, SQLite.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/sprites",
    "packages/server",
    "packages/web",
    "packages/bot"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @poq/server",
    "dev:web": "npm run dev -w @poq/web",
    "bot": "npm run start -w @poq/bot",
    "build": "npm run build -w @poq/web",
    "start": "npm run start -w @poq/server",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter=spec \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc -p packages/core && tsc -p packages/sprites && tsc -p packages/server && tsc -p packages/web && tsc -p packages/bot",
    "sprites": "tsx scripts/generate-sprites.ts",
    "db:reset": "node scripts/db-reset.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
