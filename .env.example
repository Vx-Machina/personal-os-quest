# Copy to .env and fill in. Never commit .env.

# --- API server ---
PORT=8787
HOST=127.0.0.1
# SQLite file (created on first run)
DB_PATH=./data/quest.db
# Defaults for new players (each player can change these in Settings)
DEFAULT_TIMEZONE=Europe/Paris
DEFAULT_RESET_TIME=04:00
# Name of the local single-player character created on first run
PLAYER_NAME=Example Hero

# --- Discord bot (only needed for `npm run bot`) ---
# Bot token from the Discord developer portal. Keep it secret.
DISCORD_TOKEN=
# Optional: a test server (guild) id. Commands register instantly there.
# Leave empty to register globally (can take up to an hour to appear).
DISCORD_GUILD_ID=
# Optional: your own Discord user id. Links your Discord account to the
# local web player so both front ends control the same character.
DISCORD_OWNER_ID=
# Where the bot reaches the API (keep the port in sync with PORT)
API_URL=http://127.0.0.1:8787
